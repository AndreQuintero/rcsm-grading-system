# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public base URL of the app; the password-setup links are built from this, never from the request.
APP_BASE_URL=https://rcsm-grading-system.vercel.app

# EmailJS (Account > API keys; enable "Allow EmailJS API for non-browser applications").
# The template uses the variables {{email}}, {{link}} and {{name}}.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
